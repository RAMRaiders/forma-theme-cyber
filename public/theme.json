{
  "id": "cyber",
  "name": "Cyber",
  "version": "0.7.6",
  "entry": "index.html",
  "sdk": "^1.14",
  "permissions": ["settings.system"],
  "resolutions": ["1280x720", "1920x1080"],
  "views": ["systems"],
  "draws": ["nowPlaying"],
  "settings": [
    {
      "key": "textSize",
      "label": "Text size",
      "group": "Look",
      "type": "choice",
      "choices": [
        { "value": "small", "label": "Small" },
        { "value": "normal", "label": "Normal" },
        { "value": "large", "label": "Large" }
      ],
      "default": "normal"
    },
    {
      "key": "board",
      "label": "Circuit board",
      "description": "The system’s board behind the screens",
      "group": "Look",
      "type": "choice",
      "choices": [
        { "value": "on", "label": "On" },
        { "value": "dim", "label": "Dimmed" },
        { "value": "off", "label": "Off" }
      ],
      "default": "on"
    },
    {
      "key": "motion",
      "label": "Animations",
      "description": "Pulsing traces, loaders",
      "group": "Look",
      "type": "toggle",
      "default": true
    },
    {
      "key": "previews",
      "label": "Video previews",
      "description": "In a game list, after a moment on a game",
      "group": "Look",
      "type": "toggle",
      "default": true
    },
    {
      "key": "rotateFacts",
      "label": "Rotate curiosities",
      "description": "On a system’s page, every 10 seconds",
      "group": "Look",
      "type": "toggle",
      "default": true
    },
    {
      "key": "systemsSort",
      "label": "Systems",
      "description": "In each category",
      "group": "Sorting",
      "type": "choice",
      "choices": [
        { "value": "games", "label": "Most games first" },
        { "value": "name", "label": "By name" },
        { "value": "year", "label": "Oldest first" },
        { "value": "maker", "label": "By maker" }
      ],
      "default": "games"
    }
  ]
}
