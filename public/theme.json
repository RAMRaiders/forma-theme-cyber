{
  "id": "cyber",
  "name": "Cyber",
  "version": "0.13.1",
  "entry": "index.html",
  "logo": "logo.svg",
  "sdk": "^1.26",
  "permissions": ["settings.system", "settings.emulators"],
  "resolutions": ["1280x720", "1920x1080"],
  "views": ["systems"],
  "draws": ["nowPlaying"],
  "settings": [
    {
      "key": "textSize",
      "label": "Text size",
      "group": "Look",
      "type": "choice",
      "choices": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "key": "board",
      "label": "Circuit board",
      "description": "The system’s board behind the screens",
      "group": "Look",
      "type": "choice",
      "choices": [
        {
          "value": "on",
          "label": "On"
        },
        {
          "value": "dim",
          "label": "Dimmed"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ],
      "default": "on"
    },
    {
      "key": "systemsLook",
      "label": "Systems background",
      "description": "Behind a category’s systems",
      "group": "Look",
      "type": "choice",
      "choices": [
        {
          "value": "neon",
          "label": "Neon"
        },
        {
          "value": "grid",
          "label": "Neon grid"
        },
        {
          "value": "board",
          "label": "Circuit board"
        }
      ],
      "default": "neon"
    },
    {
      "key": "motion",
      "label": "Animations",
      "description": "Pulsing traces, loaders",
      "group": "Look",
      "type": "toggle",
      "default": true
    },
    {
      "key": "gamesView",
      "label": "View",
      "description": "How a game list shows its games",
      "group": "Games",
      "select": ["games"],
      "type": "choice",
      "choices": [
        {
          "value": "immersive",
          "label": "Immersive"
        },
        {
          "value": "collector",
          "label": "Collector"
        }
      ],
      "default": "immersive"
    },
    {
      "key": "previews",
      "label": "Video previews",
      "description": "In a game list, after a moment on a game",
      "group": "Look",
      "type": "toggle",
      "default": true
    },
    {
      "key": "rotateFacts",
      "label": "Rotate curiosities",
      "description": "On a system’s page, every 10 seconds",
      "group": "Look",
      "type": "toggle",
      "default": true
    }
  ],
  "scraper": {
    "media": ["boxback", "cartridge", "fanart", "manual"],
    "fields": ["ageRating"],
    "viewSetting": "gamesView",
    "shows": [
      "thumbnail",
      "boxart",
      "boxback",
      "boxside",
      "cartridge",
      "image",
      "titleshot",
      "mix",
      "map",
      "video",
      "fanart",
      "wheel",
      "marquee",
      "manual"
    ],
    "backups": { "marquee": "wheel", "boxart": "thumbnail" },
    "views": {
      "collector": { "media": ["boxside"] }
    }
  }
}
